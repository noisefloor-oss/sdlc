{
  "id": "kilo",
  "executable": "kilo",
  "versionProbe": {"argv": ["kilo", "--version"], "timeoutSeconds": 5, "format": "lines", "source": "static"},
  "versionPattern": "^(?P<version>[0-9]+\\.[0-9]+\\.[0-9]+)$",
  "enumerationProbe": {"argv": ["kilo", "models", "--pure"], "timeoutSeconds": 10, "format": "lines", "source": "configured"},
  "isolation": "external-required",
  "ranges": [{
    "minimum": "7.4.21",
    "maximumExclusive": "7.4.22",
    "status": "experimental",
    "capabilities": ["noninteractive", "structured-output", "reasoning-level", "resume", "model-enumeration"],
    "reasoningLevels": ["minimal", "low", "medium", "high", "max"],
    "run": ["kilo", "run", "--pure", "--format", "json", "--model", "{model}", "--variant", "{reasoning}", "--dir", "{workspace}", "{prompt}"],
    "modelFlag": "--model",
    "reasoningFlag": "--variant",
    "structuredOutput": "--format json",
    "certification": {"schema": false, "argv": false, "fakeCli": false, "resolver": false, "live": "missing", "deck": "missing", "testedVersions": [], "certifiedAt": null, "resultDigest": null}
  }],
  "models": [
    {"id": "kilo/anthropic/claude-opus-5", "modelFamily": "anthropic-claude-5", "qualityTier": "frontier", "entitlement": "unknown", "reasoningLevels": ["low", "medium", "high", "max"], "status": "experimental"},
    {"id": "kilo/anthropic/claude-sonnet-5", "modelFamily": "anthropic-claude-5", "qualityTier": "balanced", "entitlement": "unknown", "reasoningLevels": ["low", "medium", "high", "max"], "status": "experimental"},
    {"id": "kilo/deepseek/deepseek-v4-pro", "modelFamily": "deepseek-v4", "qualityTier": "balanced", "entitlement": "unknown", "reasoningLevels": ["high", "max"], "status": "experimental"},
    {"id": "kilo/kilo-auto/efficient", "modelFamily": "kilo-auto", "qualityTier": "economy", "entitlement": "unknown", "reasoningLevels": ["low", "medium", "high"], "status": "experimental"},
    {"id": "kilo/kilo-auto/frontier", "modelFamily": "kilo-auto", "qualityTier": "frontier", "entitlement": "unknown", "reasoningLevels": ["low", "medium", "high", "max"], "status": "experimental"},
    {"id": "kilo/moonshotai/kimi-k3", "modelFamily": "moonshot-kimi-k3", "qualityTier": "frontier", "entitlement": "unknown", "reasoningLevels": ["high", "max"], "status": "experimental"},
    {"id": "kilo/z-ai/glm-5.2", "modelFamily": "zai-glm-5.2", "qualityTier": "balanced", "entitlement": "unknown", "reasoningLevels": ["high", "max"], "status": "experimental"}
  ],
  "sources": ["https://kilo.ai/docs/code-with-ai/platforms/cli-reference", "https://kilo.ai/docs/code-with-ai/platforms/cli"]
}
