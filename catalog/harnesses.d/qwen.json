{
  "id": "qwen",
  "executable": "qwen",
  "versionProbe": {"argv": ["qwen", "--version"], "timeoutSeconds": 5, "format": "lines", "source": "static"},
  "versionPattern": "^(?P<version>[0-9]+\\.[0-9]+\\.[0-9]+)$",
  "enumerationProbe": null,
  "isolation": "harness-permissions",
  "ranges": [{
    "minimum": "0.21.14",
    "maximumExclusive": "0.21.15",
    "status": "experimental",
    "capabilities": ["noninteractive", "structured-output", "resume"],
    "reasoningLevels": [],
    "run": ["qwen", "--prompt", "{prompt}", "--output-format", "json", "--model", "{model}"],
    "modelFlag": "--model",
    "reasoningFlag": null,
    "structuredOutput": "--output-format json",
    "certification": {"schema": false, "argv": false, "fakeCli": false, "resolver": false, "live": "missing", "deck": "missing", "testedVersions": [], "certifiedAt": null, "resultDigest": null}
  }],
  "models": [
    {"id": "coder-model", "modelFamily": "qwen3.5-coder", "qualityTier": "balanced", "entitlement": "unknown", "reasoningLevels": [], "status": "experimental"},
    {"id": "qwen3-coder-plus", "modelFamily": "qwen3-coder", "qualityTier": "frontier", "entitlement": "unknown", "reasoningLevels": [], "status": "experimental"}
  ],
  "sources": ["https://github.com/QwenLM/qwen-code/blob/main/docs/users/configuration/settings.md"]
}
