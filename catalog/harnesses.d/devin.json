{
  "id": "devin",
  "executable": "devin",
  "versionProbe": {"argv": ["devin", "--version"], "timeoutSeconds": 5, "format": "lines", "source": "static"},
  "versionPattern": "^devin (?P<version>[0-9]+\\.[0-9]+\\.[0-9]+)(?: \\([0-9a-f]+\\))?$",
  "enumerationProbe": {"argv": ["devin", "models", "list", "--format", "json"], "timeoutSeconds": 10, "format": "json", "source": "entitled", "idFields": ["model_uid"]},
  "isolation": "harness-permissions",
  "ranges": [{
    "minimum": "3000.3.27",
    "maximumExclusive": "3000.3.28",
    "status": "experimental",
    "capabilities": ["noninteractive", "resume", "permission-boundary", "model-enumeration"],
    "reasoningLevels": [],
    "run": ["devin", "--model", "{model}", "--permission-mode", "accept-edits", "--sandbox", "--respect-workspace-trust", "true", "--print", "{prompt}"],
    "modelFlag": "--model",
    "reasoningFlag": null,
    "structuredOutput": null,
    "certification": {"schema": false, "argv": false, "fakeCli": false, "resolver": false, "live": "missing", "deck": "missing", "testedVersions": [], "certifiedAt": null, "resultDigest": null}
  }],
  "models": [
    {"id": "claude-opus-5-high", "modelFamily": "anthropic-claude-5", "qualityTier": "frontier", "entitlement": "unknown", "reasoningLevels": [], "status": "experimental"},
    {"id": "claude-sonnet-5-high", "modelFamily": "anthropic-claude-5", "qualityTier": "balanced", "entitlement": "unknown", "reasoningLevels": [], "status": "experimental"},
    {"id": "deepseek-v4-pro-high", "modelFamily": "deepseek-v4", "qualityTier": "balanced", "entitlement": "unknown", "reasoningLevels": [], "status": "experimental"},
    {"id": "glm-5-2", "modelFamily": "zai-glm-5.2", "qualityTier": "balanced", "entitlement": "unknown", "reasoningLevels": [], "status": "experimental"},
    {"id": "gpt-5-6-luna-high", "modelFamily": "openai-gpt-5.6", "qualityTier": "economy", "entitlement": "unknown", "reasoningLevels": [], "status": "experimental"},
    {"id": "gpt-5-6-sol-high", "modelFamily": "openai-gpt-5.6", "qualityTier": "frontier", "entitlement": "unknown", "reasoningLevels": [], "status": "experimental"},
    {"id": "kimi-k3-high", "modelFamily": "moonshot-kimi-k3", "qualityTier": "frontier", "entitlement": "unknown", "reasoningLevels": [], "status": "experimental"}
  ],
  "sources": ["https://docs.devin.ai/get-started/devin-intro", "https://github.com/CognitionAI/devin-cli"]
}
