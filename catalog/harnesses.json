{
  "schemaVersion": 1,
  "catalog": "noise/harnesses@0.5",
  "harnesses": [
    {
      "id": "codex", "executable": "codex",
      "versionProbe": {"argv": ["codex", "--version"], "timeoutSeconds": 5, "format": "lines", "source": "static"},
      "versionPattern": "^(?:codex-cli )?(?P<version>[0-9]+\\.[0-9]+\\.[0-9]+)$",
      "enumerationProbe": {"argv": ["codex", "debug", "models", "--bundled"], "timeoutSeconds": 10, "format": "json", "source": "static", "idFields": ["slug"]},
      "isolation": "harness-permissions",
      "ranges": [{
        "minimum": "0.147.0", "maximumExclusive": "0.147.1", "status": "experimental",
        "capabilities": ["noninteractive", "structured-output", "reasoning-level", "ephemeral-session", "resume", "permission-boundary", "model-enumeration"],
        "reasoningLevels": ["minimal", "low", "medium", "high", "xhigh"],
        "run": ["codex", "exec", "--ephemeral", "--json", "--model", "{model}", "--config", "model_reasoning_effort=\"{reasoning}\"", "--cd", "{workspace}", "{prompt}"],
        "modelFlag": "--model", "reasoningFlag": "--config model_reasoning_effort", "structuredOutput": "--json",
        "certification": {"schema": false, "argv": false, "fakeCli": false, "resolver": false, "live": "missing", "deck": "missing", "testedVersions": [], "certifiedAt": null, "resultDigest": null}
      }],
      "models": [
        {"id": "gpt-5.6-sol", "modelFamily": "openai-gpt-5.6", "qualityTier": "frontier", "entitlement": "included", "reasoningLevels": ["low", "medium", "high", "xhigh"], "status": "experimental"},
        {"id": "gpt-5.6-terra", "modelFamily": "openai-gpt-5.6", "qualityTier": "balanced", "entitlement": "included", "reasoningLevels": ["low", "medium", "high", "xhigh"], "status": "experimental"},
        {"id": "gpt-5.6-luna", "modelFamily": "openai-gpt-5.6", "qualityTier": "economy", "entitlement": "included", "reasoningLevels": ["low", "medium", "high"], "status": "experimental"}
      ],
      "sources": ["https://developers.openai.com/codex/cli/reference/", "https://learn.chatgpt.com/docs/config-file/config-reference"]
    },
    {
      "id": "claude", "executable": "claude",
      "versionProbe": {"argv": ["claude", "--version"], "timeoutSeconds": 5, "format": "lines", "source": "static"},
      "versionPattern": "^(?P<version>[0-9]+\\.[0-9]+\\.[0-9]+)(?: \\(Claude Code\\))?$",
      "enumerationProbe": null, "isolation": "harness-permissions",
      "ranges": [{
        "minimum": "2.1.232", "maximumExclusive": "2.1.233", "status": "experimental",
        "capabilities": ["noninteractive", "structured-output", "reasoning-level", "ephemeral-session", "resume", "read-only-tools", "permission-boundary"],
        "reasoningLevels": ["low", "medium", "high", "xhigh", "max"],
        "run": ["claude", "--print", "--output-format", "stream-json", "--model", "{model}", "--effort", "{reasoning}", "--permission-mode", "dontAsk", "--no-session-persistence", "{prompt}"],
        "modelFlag": "--model", "reasoningFlag": "--effort", "structuredOutput": "--output-format stream-json",
        "certification": {"schema": false, "argv": false, "fakeCli": false, "resolver": false, "live": "missing", "deck": "missing", "testedVersions": [], "certifiedAt": null, "resultDigest": null}
      },
        {
          "minimum": "2.1.263",
          "maximumExclusive": "2.1.264",
          "status": "experimental",
          "capabilities": [
            "noninteractive",
            "reasoning-level",
            "ephemeral-session",
            "resume",
            "read-only-tools",
            "permission-boundary"
          ],
          "reasoningLevels": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "run": [
            "claude",
            "--print",
            "--input-format",
            "text",
            "--output-format",
            "text",
            "--model",
            "{model}",
            "--effort",
            "{reasoning}",
            "--permission-mode",
            "dontAsk",
            "--no-session-persistence"
          ],
          "modelFlag": "--model",
          "reasoningFlag": "--effort",
          "structuredOutput": null,
          "certification": {
            "schema": false,
            "argv": false,
            "fakeCli": false,
            "resolver": false,
            "live": "missing",
            "deck": "missing",
            "testedVersions": [],
            "certifiedAt": null,
            "resultDigest": null
          },
          "invocation": {
            "schemaVersion": 1,
            "actions": {
              "execution": {
                "argv": [
                  "claude",
                  "--print",
                  "--input-format",
                  "text",
                  "--output-format",
                  "text",
                  "--model",
                  "{model}",
                  "--effort",
                  "{reasoning}",
                  "--permission-mode",
                  "dontAsk",
                  "--no-session-persistence"
                ],
                "workingDirectory": "process-cwd",
                "prompt": {
                  "transport": "stdin-text",
                  "maxBytes": 262144
                },
                "permissions": {
                  "mode": "harness-policy",
                  "externalBoundary": "required",
                  "limitations": [
                    "dontAsk is a harness permission policy, not a read-only filesystem boundary.",
                    "The runner must enforce authorized filesystem and publication effects."
                  ]
                },
                "output": {
                  "normalizer": "final-text-v1",
                  "maxBytes": 1048576
                },
                "completion": {
                  "successExitCode": 0,
                  "requiresFinalOutput": true,
                  "taskCompletion": "not-established"
                }
              },
              "review": {
                "argv": [
                  "claude",
                  "--print",
                  "--input-format",
                  "text",
                  "--output-format",
                  "text",
                  "--model",
                  "{model}",
                  "--effort",
                  "{reasoning}",
                  "--permission-mode",
                  "dontAsk",
                  "--no-session-persistence"
                ],
                "workingDirectory": "process-cwd",
                "prompt": {
                  "transport": "stdin-text",
                  "maxBytes": 262144
                },
                "permissions": {
                  "mode": "harness-policy",
                  "externalBoundary": "required",
                  "limitations": [
                    "dontAsk is a harness permission policy, not a read-only filesystem boundary.",
                    "The runner must enforce authorized filesystem and publication effects."
                  ]
                },
                "output": {
                  "normalizer": "final-text-v1",
                  "maxBytes": 1048576
                },
                "completion": {
                  "successExitCode": 0,
                  "requiresFinalOutput": true,
                  "taskCompletion": "not-established"
                },
                "publication": {
                  "contract": "noise-review-v1",
                  "actor": "reviewer",
                  "requiresReadback": true,
                  "auditRecord": "last-nonempty-line-json"
                }
              }
            }
          }
        }],
      "models": [
        {"id": "claude-fable-5", "modelFamily": "anthropic-claude-5", "qualityTier": "frontier", "entitlement": "unknown", "reasoningLevels": ["low", "medium", "high", "xhigh", "max"], "status": "experimental"},
        {"id": "claude-opus-5", "modelFamily": "anthropic-claude-5", "qualityTier": "frontier", "entitlement": "unknown", "reasoningLevels": ["low", "medium", "high", "xhigh", "max"], "status": "experimental"},
        {"id": "claude-sonnet-5", "modelFamily": "anthropic-claude-5", "qualityTier": "balanced", "entitlement": "unknown", "reasoningLevels": ["low", "medium", "high", "xhigh"], "status": "experimental"}
      ],
      "sources": ["https://code.claude.com/docs/en/cli-usage"]
    },
    {
      "id": "kimi", "executable": "kimi",
      "versionProbe": {"argv": ["kimi", "--version"], "timeoutSeconds": 5, "format": "lines", "source": "static"},
      "versionPattern": "^(?P<version>[0-9]+\\.[0-9]+\\.[0-9]+)$",
      "enumerationProbe": null, "isolation": "external-required",
      "ranges": [{
        "minimum": "0.39.0", "maximumExclusive": "0.39.1", "status": "experimental",
        "capabilities": ["noninteractive", "structured-output", "resume"],
        "reasoningLevels": [],
        "run": ["kimi", "--model", "{model}", "--output-format", "stream-json", "--prompt", "{prompt}"],
        "modelFlag": "--model", "reasoningFlag": null, "structuredOutput": "--output-format stream-json",
        "certification": {"schema": false, "argv": false, "fakeCli": false, "resolver": false, "live": "missing", "deck": "missing", "testedVersions": [], "certifiedAt": null, "resultDigest": null}
      }],
      "models": [
        {"id": "kimi-code/k3", "modelFamily": "moonshot-kimi-k3", "qualityTier": "frontier", "entitlement": "included", "reasoningLevels": ["high"], "status": "experimental"}
      ],
      "sources": ["https://moonshotai.github.io/kimi-code/en/reference/kimi-command.html", "https://moonshotai.github.io/kimi-code/en/configuration/config-files.html"]
    },
    {
      "id": "opencode", "executable": "opencode",
      "versionProbe": {"argv": ["opencode", "--version"], "timeoutSeconds": 5, "format": "lines", "source": "static"},
      "versionPattern": "^(?P<version>[0-9]+\\.[0-9]+\\.[0-9]+)$",
      "enumerationProbe": {"argv": ["opencode", "models", "--pure"], "timeoutSeconds": 10, "format": "lines", "source": "configured"},
      "isolation": "external-required",
      "ranges": [{
        "minimum": "1.18.23", "maximumExclusive": "1.18.24", "status": "experimental",
        "capabilities": ["noninteractive", "structured-output", "reasoning-level", "resume", "model-enumeration"],
        "reasoningLevels": ["minimal", "low", "medium", "high", "max"],
        "run": ["opencode", "run", "--auto", "--format", "json", "--model", "{model}", "--variant", "{reasoning}", "--dir", "{workspace}", "{prompt}"],
        "modelFlag": "--model", "reasoningFlag": "--variant", "structuredOutput": "--format json",
        "certification": {"schema": false, "argv": false, "fakeCli": false, "resolver": false, "live": "missing", "deck": "missing", "testedVersions": [], "certifiedAt": null, "resultDigest": null}
      }],
      "models": [
        {"id": "opencode-go/deepseek-v4-flash", "modelFamily": "deepseek-v4", "qualityTier": "economy", "entitlement": "included", "reasoningLevels": ["high", "max"], "status": "experimental"},
        {"id": "opencode-go/deepseek-v4-pro", "modelFamily": "deepseek-v4", "qualityTier": "balanced", "entitlement": "included", "reasoningLevels": ["high", "max"], "status": "experimental"},
        {"id": "opencode/deepseek-v4-flash-free", "modelFamily": "deepseek-v4", "qualityTier": "economy", "entitlement": "included", "reasoningLevels": ["high"], "status": "experimental"},
        {"id": "opencode-go/glm-5.3", "modelFamily": "zai-glm-5.3", "qualityTier": "frontier", "entitlement": "unknown", "reasoningLevels": ["low", "high", "max"], "status": "experimental"}
      ],
      "sources": ["https://opencode.ai/docs/cli/", "https://opencode.ai/docs/models/", "https://opencode.ai/docs/providers", "https://z.ai/blog/glm-5.3"]
    }
  ]
}
